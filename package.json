{
  "name": "newstelagualbertodoceria-site",
  "version": "1.0.0",
  "private": true,
  "projectType": "site",
  "description": "Site institucional e LinkBio oficial da Stela Gualberto Doceria em Divinopolis MG",
  "keywords": [
    "site",
    "institucional",
    "linkbio",
    "doceria",
    "confeitaria",
    "divinopolis"
  ],
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "sync:reviews": "node scripts/sync_google_reviews.mjs",
    "audit:visual": "node scripts/audit_visual_legibility.mjs",
    "deploy": "wrangler pages deploy dist --project-name=newstelagualbertodoceria --branch=main"
  },
  "dependencies": {
    "@astrojs/react": "^4.2.1",
    "astro": "^5.5.2",
    "gsap": "^3.12.7",
    "lenis": "^1.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitest/coverage-v8": "^3.0.8",
    "eslint": "^9.21.0",
    "playwright": "^1.65.1",
    "sharp": "^0.33.5",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.8",
    "wrangler": "^4.114.0"
  }
}
